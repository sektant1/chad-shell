#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/dionysus.sh
source "$SCRIPT_DIR/lib/dionysus.sh"

load_local_env
status=0

check_cmd() {
  local cmd=$1 level=${2:-optional}
  if has_cmd "$cmd"; then
    printf 'ok   command: %s\n' "$cmd"
  else
    printf '%s command missing: %s\n' "$level" "$cmd"
    if [[ "$level" == "required" ]]; then
      status=1
    fi
  fi
  return 0
}

printf 'Dionysus doctor\n'
printf 'distro: %s\n' "$(detect_distro)"
printf 'session: %s\n' "${XDG_SESSION_TYPE:-unknown}"

for cmd in bash awk sed grep find; do
  check_cmd "$cmd" required
done

for cmd in hyprctl waybar rofi alacritty kitty foot wezterm ghostty xterm eww cava wpctl pactl brightnessctl playerctl jq xrandr xdg-open pavucontrol notify-send alsamixer shellcheck shfmt; do
  check_cmd "$cmd" optional
done

if battery="$(first_battery)"; then
  printf 'ok   battery: %s\n' "${battery##*/}"
else
  printf 'info battery: none detected; battery widgets should hide gracefully\n'
fi

if iface="$(active_network_interface)"; then
  printf 'ok   network: %s\n' "$iface"
else
  printf 'info network: no active interface detected\n'
fi

if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
  printf 'info display: Wayland detected; use compositor-native monitor tools\n'
else
  "$SCRIPT_DIR/display-autoconfig" --dry-run || true
fi

if has_cmd fc-match; then
  printf 'font JetBrainsMono Nerd Font: %s\n' "$(fc-match 'JetBrainsMono Nerd Font' | head -n 1)"
  printf 'font monospace fallback: %s\n' "$(fc-match monospace | head -n 1)"
fi

exit "$status"

