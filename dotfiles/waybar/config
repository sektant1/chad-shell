{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "height": 43,
    "exclusive": true,
    "passthrough": false,
    "modules-left": [
        "clock",
        "custom/power",
        "custom/screenshot",
        "custom/files",
        "custom/nvim",
        "custom/vpn"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "custom/microphone",
        "custom/volume",
        "custom/brightness",
        "custom/battery"
    ],
    "clock": {
        "tooltip-format": "{calendar}",
        "format-alt": " {:%a %d %b}",
        "format": " {:%I:%M}"
    },
    "network": {
        "format-wifi": "[ <span size=\"large\"></span> ]",
        "format-ethernet": "[ <span size=\"large\">󰈀</span> ]",
        "format-disconnected": "[ <span size=\"large\">󰤮</span> ]",
        "tooltip-format-wifi": "{essid}\nDown {bandwidthDownBytes} Up {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nDown {bandwidthDownBytes} Up {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "sh -c 'command -v nm-connection-editor >/dev/null 2>&1 && nm-connection-editor'",
        "interval": 5,
        "markup": "pango"
    },
    "bluetooth": {
        "format": "[ <span size=\"large\"></span> ]",
        "format-disabled": "[ <span size=\"large\">󰂲</span> ]",
        "on-click": "~/.config/waybar/scripts/bluetooth-toggle.sh",
        "tooltip-format": "Bluetooth is {status}",
        "interval": 5,
        "on-click-right": "sh -c 'command -v blueman-manager >/dev/null 2>&1 && blueman-manager'",
        "markup": "pango"
    },
    "custom/battery": {
        "exec": "~/.config/waybar/scripts/battery.sh",
        "return-type": "json",
        "interval": 10,
        "markup": "pango"
    },
    "custom/microphone": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "Mic toggle",
        "signal": 8,
        "on-click": "sh -c 'if command -v wpctl >/dev/null 2>&1; then wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; elif command -v pactl >/dev/null 2>&1; then pactl set-source-mute @DEFAULT_SOURCE@ toggle; fi; command -v pkill >/dev/null 2>&1 && pkill -RTMIN+8 waybar'",
        "on-click-right": "~/.config/waybar/scripts/audio-settings.sh",
        "markup": "pango"
    },
    "custom/brightness": {
        "exec": "~/.config/waybar/scripts/brightness.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/brightness-toggle.sh",
        "on-scroll-up": "sh -c 'command -v brightnessctl >/dev/null 2>&1 && brightnessctl set +5%'",
        "on-scroll-down": "sh -c 'command -v brightnessctl >/dev/null 2>&1 && brightnessctl set 5%-'",
        "markup": "pango"
    },
    "custom/volume": {
        "exec": "~/.config/waybar/scripts/volume.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "sh -c 'command -v wpctl >/dev/null 2>&1 && wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'",
        "on-click-right": "~/.config/waybar/scripts/audio-settings.sh",
        "on-scroll-up": "sh -c 'command -v wpctl >/dev/null 2>&1 && wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+'",
        "on-scroll-down": "sh -c 'command -v wpctl >/dev/null 2>&1 && wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'",
        "markup": "pango"
    },
    "custom/nvim": {
        "format": "[ <span size=\"large\"></span> ]",
        "tooltip": true,
        "tooltip-format": "Open Neovim",
        "on-click": "alacritty -e nvim",
        "markup": "pango"
    },
    "custom/files": {
        "format": "[ <span size=\"large\"></span> ]",
        "tooltip": true,
        "tooltip-format": "Open files",
        "on-click": "~/.config/waybar/scripts/open-home.sh",
        "markup": "pango"
    },
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/nordvpn-status.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "~/.config/waybar/scripts/nordvpn-toggle.sh",
        "format": "{}",
        "markup": "pango",
        "tooltip": true,
        "tooltip-format": "VPN status"
    },
    "custom/power": {
        "format": "[ <span size=\"large\">⏻</span> ]",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/scripts/powermenu.sh",
        "markup": "pango"
    },
    "hyprland/workspaces": {
        "format": "[{icon}]",
        "format-icons": {
            "1": "Д",
            "2": "Б",
            "3": "В",
            "4": "Г",
            "5": "Й",
            "6": "Е",
            "7": "Ж",
            "8": "З",
            "9": "И",
            "10": "К",
            "active": "●"
        },
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4
            ]
        },
        "on-click": "activate",
        "sort-by-number": true,
        "all-outputs": false
    },
    "custom/screenshot": {
        "format": "[ <span size=\"large\"></span> ]",
        "tooltip": true,
        "tooltip-format": "Screenshot region",
        "on-click": "~/.config/waybar/scripts/screenshot.sh",
        "markup": "pango"
    }
}
