#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=scripts/lib/dionysus.sh
source "$SCRIPT_DIR/lib/dionysus.sh"

dry_run=false
force=false
modules=()

usage() {
  cat <<'EOF'
Usage: scripts/install [--dry-run] [--force] [module...]

Safely symlink dotfiles/<module> into XDG_CONFIG_HOME.
Existing files are backed up before replacement unless they are already the
expected symlink. Use --dry-run to print planned actions only.
EOF
}

while (($#)); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --force) force=true ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) modules+=("$1") ;;
  esac
  shift
done

config_home="$(xdg_config_home)"
state_home="$(xdg_state_home)"
backup_dir="$state_home/dionysus/backups/$(date +%Y%m%d-%H%M%S)"

if ((${#modules[@]} == 0)); then
  mapfile -t modules < <(find "$REPO_DIR/dotfiles" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort)
fi

say_run() {
  printf '+'
  printf ' %q' "$@"
  printf '\n'
  if [[ "$dry_run" == false ]]; then
    "$@"
  fi
}

for module in "${modules[@]}"; do
  src="$REPO_DIR/dotfiles/$module"
  dest="$config_home/$module"
  if [[ ! -d "$src" ]]; then
    printf 'Unknown module: %s\n' "$module" >&2
    exit 2
  fi

  if [[ -L "$dest" && "$(readlink "$dest")" == "$src" ]]; then
    printf 'Already linked: %s -> %s\n' "$dest" "$src"
    continue
  fi

  if [[ -e "$dest" || -L "$dest" ]]; then
    if [[ "$dry_run" == true ]]; then
      printf 'Would backup existing %s to %s/%s\n' "$dest" "$backup_dir" "$module"
      printf '+ ln -s %q %q\n' "$src" "$dest"
      continue
    fi
    if [[ "$force" != true ]]; then
      printf 'Refusing to replace %s without --force. Backup would be %s\n' "$dest" "$backup_dir" >&2
      exit 3
    fi
    say_run mkdir -p "$backup_dir"
    say_run mv "$dest" "$backup_dir/$module"
  fi

  say_run mkdir -p "$config_home"
  say_run ln -s "$src" "$dest"
done

printf 'Install complete%s.\n' "$([[ "$dry_run" == true ]] && printf ' dry-run' || true)"

