* {
  font: "JetBrainsMono Nerd Font Mono 16";
  padding: 4px;
  background-color: transparent;
  border-radius: 0px;
  text-color: #fab387;
}

window {
  width: 56%;
  height: 58%;
  location: center;
  border: 2px;
  border-radius: 0px;
  border-color: #61afef;
  background-color: rgba(8, 12, 16, 0.90);
  padding: 0px;
}

mainbox {
  orientation: horizontal;
  children: [ "borderbox" ];
  spacing: 0px;
  padding: 0px;
}

borderbox {
  orientation: horizontal;
  children: [ "imagebox", "contentbox" ];
  padding: 0px;
  spacing: 0px;
  border-radius: 0px;
}

contentbox {
  orientation: vertical;
  children: [ "entry", "listview" ];
  spacing: 0px;
  padding: 0px;
  expand: true;
}

imagebox {
  background-image: url("~/.config/rofi/image.png", both);
  width: 28%;
  height: 100%;
  padding: 0px;
  border-right: 2px;
  border-color: #61afef;
}

element {
  border-radius: 0px;
}

element-text,
element-icon {
  padding: 4px 6px;
  spacing: 2px;
  text-color: #fab387;
}

element selected {
  background-color: #101820;
  text-color: #fab387;
  border-radius: 0px;
}

prompt {
  enabled: false;
}

entry {
  padding: 8px;
  expand: false;
  font: "JetBrainsMono Nerd Font Mono 18";
  text-color: #fab387;
  border-radius: 0px;
  background-color: rgba(12, 17, 22, 0.94);
}

listview {
  lines: 6;
  columns: 1;
  dynamic: true;
  scrollbar: false;
  background-color: rgba(8, 12, 16, 0.92);
  border-radius: 0px;
  padding: 8px;
}

