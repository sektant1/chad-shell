{
    "layer": "top",
    "position": "top",
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "height": 33,
    "exclusive": true,
    "passthrough": false,
    "modules-left": [
        "clock",
        "custom/power",
        "custom/screenshot",
        "custom/files",
        "custom/nvim",
        "custom/vpn"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "pulseaudio",
        "custom/brightness",
        "battery"
    ],
    "clock": {
        "tooltip-format": "{calendar}",
        "format-alt": " {:%a %d %b}",
        "format": " {:%I:%M}"
    },
    "network": {
        "format-wifi": "[ <span size=\"large\"></span> ]",
        "format-ethernet": "[ <span size=\"large\">󰈀</span> ]",
        "format-disconnected": "[ <span size=\"large\">󰤮</span> ]",
        "tooltip-format-wifi": "{essid}\nDown {bandwidthDownBytes} Up {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\nDown {bandwidthDownBytes} Up {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "sh -c 'command -v nm-connection-editor >/dev/null 2>&1 && ~/.config/waybar/scripts/open-on-workspace.sh nm-connection-editor'",
        "interval": 30,
        "markup": "pango"
    },
    "bluetooth": {
        "format": "[ <span size=\"large\"></span> ]",
        "format-disabled": "[ <span size=\"large\">󰂲</span> ]",
        "on-click": "~/.config/waybar/scripts/bluetooth-toggle.sh",
        "tooltip-format": "Bluetooth is {status}",
        "interval": 30,
        "on-click-right": "sh -c 'command -v blueman-manager >/dev/null 2>&1 && ~/.config/waybar/scripts/open-on-workspace.sh blueman-manager'",
        "markup": "pango"
    },
    "power-profiles-daemon": {
        "format": "[ <span size='large'>{icon}</span> {profile} ]",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        },
        "on-click": "~/.config/waybar/scripts/power-profile-toggle.sh",
        "markup": "pango"
    },
    "custom/microphone": {
        "exec": "~/.config/waybar/scripts/mic.sh",
        "return-type": "json",
        "interval": 5,
        "tooltip": true,
        "tooltip-format": "Mic toggle",
        "signal": 8,
        "on-click": "sh -c 'if command -v wpctl >/dev/null 2>&1; then wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; elif command -v pactl >/dev/null 2>&1; then pactl set-source-mute @DEFAULT_SOURCE@ toggle; fi; command -v pkill >/dev/null 2>&1 && pkill -RTMIN+8 waybar'",
        "on-click-right": "~/.config/waybar/scripts/audio-settings.sh",
        "markup": "pango"
    },
    "custom/brightness": {
        "exec": "~/.config/waybar/scripts/brightness.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 7,
        "on-click": "~/.config/waybar/scripts/brightness-toggle.sh; pkill -RTMIN+7 waybar",
        "on-scroll-up": "sh -c 'command -v brightnessctl >/dev/null 2>&1 && brightnessctl set +5%; pkill -RTMIN+7 waybar'",
        "on-scroll-down": "sh -c 'command -v brightnessctl >/dev/null 2>&1 && brightnessctl set 5%-; pkill -RTMIN+7 waybar'",
        "markup": "pango"
    },
    "pulseaudio": {
        "format": "[ <span size='large'>{icon}</span> {volume}% ]",
        "format-muted": "[ <span size='large'></span> muted ]",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "~/.config/waybar/scripts/audio-settings.sh",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "markup": "pango"
    },
    "battery": {
        "format": "[ <span size='large'>{icon}</span> {capacity}% ]",
        "format-charging": "[ <span size='large'></span> {capacity}% ]",
        "format-plugged": "[ <span size='large'></span> {capacity}% ]",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 55,
            "critical": 20
        },
        "tooltip-format": "Battery: {capacity}%",
        "on-click-right": "~/.config/waybar/scripts/power-profile-toggle.sh",
        "markup": "pango"
    },
    "custom/nvim": {
        "format": "[ <span size=\"large\"></span> ]",
        "tooltip": true,
        "tooltip-format": "Open Neovim",
        "on-click": "~/.config/waybar/scripts/open-on-workspace.sh alacritty -e nvim",
        "markup": "pango"
    },
    "custom/files": {
        "format": "[ <span size=\"large\"></span> ]",
        "tooltip": true,
        "tooltip-format": "Open files",
        "on-click": "~/.config/waybar/scripts/open-home.sh",
        "markup": "pango"
    },
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/nordvpn-status.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/nordvpn-toggle.sh; pkill -RTMIN+9 waybar",
        "format": "{}",
        "markup": "pango",
        "tooltip": true,
        "tooltip-format": "VPN status"
    },
    "custom/power": {
        "format": "[ <span size=\"large\">⏻</span> ]",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/scripts/powermenu.sh",
        "markup": "pango"
    },
    "hyprland/workspaces": {
        "format": "[{icon}]",
        "format-icons": {
            "1": "Д",
            "2": "Б",
            "3": "В",
            "4": "Г",
            "5": "Й",
            "6": "Е",
            "7": "Ж",
            "8": "З",
            "9": "И",
            "10": "К",
            "active": "●"
        },
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4
            ]
        },
        "sort-by-number": true,
        "all-outputs": false
    },
    "custom/screenshot": {
        "format": "[ <span size=\"large\"></span> ]",
        "tooltip": true,
        "tooltip-format": "Screenshot region",
        "on-click": "~/.config/waybar/scripts/screenshot.sh",
        "markup": "pango"
    }
}
